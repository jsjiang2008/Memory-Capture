<Window x:Class="MemoryCapture.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Memory Capture" Width="1120" Height="780" MinWidth="900" MinHeight="650" Background="#F4F6FA" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Files_Drop" DragOver="Files_DragOver">
 <Grid Margin="30,24,30,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal">
    <Border Width="46" Height="46" CornerRadius="13" Background="{StaticResource Accent}" Margin="0,0,14,0" VerticalAlignment="Center"><TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <StackPanel><TextBlock Text="Memory Capture" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Capture now. Keep only what matters." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ShortcutButton" Content="Ctrl + Shift + S" Click="Shortcut_Click" ToolTip="Change the global capture shortcut"/><Button Content="Exit" Click="Exit_Click" Margin="0" ToolTip="Exit the app and discard temporary captures"/></StackPanel>
  </Grid>
  <TabControl x:Name="Tabs" Grid.Row="1" Background="Transparent" BorderThickness="0">
   <TabItem Header="Captures">
    <Grid Margin="0,20,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><ComboBox x:Name="CaptureModeBox" Width="155" SelectedIndex="0" Margin="0,0,10,0" AutomationProperties.Name="Capture mode"><ComboBoxItem Content="Region"/><ComboBoxItem Content="Window"/><ComboBoxItem Content="Full display"/></ComboBox><Button x:Name="NewCaptureButton" Content="＋  New capture" Style="{StaticResource Primary}" Click="Capture_Click"/></StackPanel>
      <Border Grid.Column="1" Background="#E5F4EE" CornerRadius="14" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="●  Unsaved captures stay in memory" Foreground="#237454" FontSize="12"/></Border>
     </Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <StackPanel Margin="4,3,0,14"><TextBlock Text="RECENT CAPTURES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}"/><TextBlock x:Name="HistoryCount" Text="0 captures · 0 MB" FontSize="12" Margin="0,6,0,0" Foreground="{StaticResource Muted}"/></StackPanel>
       <ListBox Grid.Row="1" x:Name="CaptureList" SelectionChanged="CaptureList_SelectionChanged" AutomationProperties.Name="Recent captures"><ListBox.ItemTemplate><DataTemplate><StackPanel><Border Background="#E8ECF2" CornerRadius="5" Height="96"><Image Source="{Binding Image}" Stretch="Uniform"/></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Margin="0,8,0,3"/><TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
       <Button x:Name="ClearCapturesButton" Grid.Row="2" Content="Clear all" Click="ClearCaptures_Click" Margin="0,10,0,0" IsEnabled="False"/>
      </Grid></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock x:Name="CaptureDetail" Text="Your next screenshot starts here" FontWeight="SemiBold" Margin="0,0,0,16"/>
       <Border Grid.Row="1" Background="#F4F6FA" CornerRadius="8" ClipToBounds="True"><Grid><Image x:Name="CapturePreview" Stretch="Uniform" Margin="12"/><StackPanel x:Name="CaptureEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xE91B;" FontFamily="Segoe MDL2 Assets" FontSize="52" Foreground="#ABB3C8" HorizontalAlignment="Center"/><TextBlock Text="A screenshot, without the clutter" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,22,0,10"/><TextBlock Text="Capture a region, window, or display.&#10;Copy it when you need it. Save it when it matters." TextAlignment="Center" Foreground="{StaticResource Muted}" LineHeight="23"/></StackPanel></Grid></Border>
       <Grid Grid.Row="2" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="CopyCaptureButton" Content="Copy" Style="{StaticResource Primary}" Click="CopyCapture_Click" IsEnabled="False"/><Button x:Name="SaveCaptureButton" Content="Save as…" Click="SaveCapture_Click" IsEnabled="False"/></StackPanel><Button Grid.Column="1" x:Name="DeleteCaptureButton" Content="Delete" Click="DeleteCapture_Click" IsEnabled="False" Margin="0"/></Grid>
      </Grid></Border>
     </Grid>
    </Grid>
   </TabItem>
   <TabItem Header="Convert Images">
    <Grid Margin="0,20,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="AddFilesButton" Content="＋  Add images" Style="{StaticResource Primary}" Click="AddFiles_Click"/><TextBlock Grid.Column="1" Text="Or drop files here · HEIC, PNG, JPG, WebP, BMP, TIFF" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="10,0,0,0"/></Grid>
     <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="285"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="12" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock x:Name="FileCount" Text="IMAGE QUEUE · 0" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="4,3,0,14"/>
       <Grid Grid.Row="1"><ListBox x:Name="FileList" SelectionChanged="FileList_SelectionChanged" AutomationProperties.Name="Image queue"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Path}"/><TextBlock Text="{Binding Type}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,3"/><TextBlock Text="{Binding Status}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="QueueEmpty" Text="Drop a few photos here.&#10;Your originals stay untouched." TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" LineHeight="24"/></Grid>
       <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="RemoveFileButton" Content="Remove" Click="RemoveFile_Click" IsEnabled="False"/><Button x:Name="ClearFilesButton" Content="Clear all" Click="ClearFiles_Click" IsEnabled="False" Margin="0"/></StackPanel>
      </Grid></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock x:Name="ConversionDetail" Text="Preview your converted image" FontWeight="SemiBold" Margin="0,0,0,16" TextTrimming="CharacterEllipsis"/>
       <Border Grid.Row="1" Background="#F4F6FA" CornerRadius="8" MinHeight="130"><Grid><Image x:Name="ConversionPreview" Stretch="Uniform" Margin="8"/><StackPanel x:Name="ConversionEmpty" VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="44" Foreground="#ABB3C8" HorizontalAlignment="Center"/><TextBlock x:Name="ConversionEmptyText" Text="New format. Same memories." Foreground="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="350"/></StackPanel></Grid></Border>
       <Grid Grid.Row="2" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Output format" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/><ComboBox x:Name="OutputFormatBox" SelectedIndex="0" SelectionChanged="OutputOptions_Changed" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="Output format"><ComboBoxItem Content="PNG"/><ComboBoxItem Content="JPG"/><ComboBoxItem Content="WebP"/></ComboBox></StackPanel><StackPanel Grid.Column="1" x:Name="QualityPanel" Opacity="0.45"><TextBlock x:Name="QualityLabel" Text="PNG is lossless" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/><Slider x:Name="QualitySlider" Minimum="1" Maximum="100" Value="90" TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="False" ValueChanged="Quality_Changed" AutomationProperties.Name="Output quality"/></StackPanel></Grid>
       <TextBlock Grid.Row="3" Text="Nothing is saved until you choose Save. Copy uses full resolution." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,14" TextWrapping="Wrap"/>
       <WrapPanel Grid.Row="4"><Button x:Name="CopyConvertedButton" Content="Copy preview" Click="CopyConverted_Click" IsEnabled="False"/><Button x:Name="SaveSelectedButton" Content="Save selected…" Click="SaveSelected_Click" IsEnabled="False"/><Button x:Name="SaveAllButton" Content="Save all…" Style="{StaticResource Primary}" Click="SaveAll_Click" IsEnabled="False" Margin="0"/></WrapPanel>
      </Grid></Border>
     </Grid>
    </Grid>
   </TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="Ready · All image processing stays on this computer." Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"/><ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="5" VerticalAlignment="Center" Visibility="Collapsed" Margin="12,0"/><Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" Padding="12,5" MinHeight="28" Margin="0"/></Grid>
 </Grid>
</Window>
